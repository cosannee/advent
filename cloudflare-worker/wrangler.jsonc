{
  "name": "markov-letter-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "enabled": true } },
  "vars": {
    "ALLOWED_ORIGIN": "https://cosannee.github.io"
  },
  "durable_objects": {
    "bindings": [
      { "name": "LETTER_LIMITER", "class_name": "DailyLimiter" }
    ]
  },
  "exports": {
    "DailyLimiter": { "type": "durable-object", "storage": "sqlite" }
  }
}
